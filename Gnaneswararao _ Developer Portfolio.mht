------MultipartBoundary--w4K6kysfVBIUwTKg4CFQNsFbkVSOoXcPZdOd6wLnXK----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://resupply-junction-residual.ngrok-free.dev/gnaneswararao_portfolio/style.css

@charset "utf-8";

:root { --bg: #080b14; --panel: #101624; --panel2: #0d1320; --text: #f2f5fb; --muted: #9aa6bb; --line: rgba(166,184,220,.15); --blue: #65d5ff; --purple: #a78bfa; --green: #9cf5cb; --font: 'Manrope',sans-serif; --mono: 'DM Mono',monospace; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; scroll-padding-top: 90px; }

body { font-family: var(--font); background: var(--bg); color: var(--text); overflow-x: hidden; line-height: 1.6; }

a { color: inherit; text-decoration: none; }

.container { width: min(1120px, 100% - 48px); margin: auto; }

.page-glow { position: absolute; z-index: -1; pointer-events: none; filter: blur(90px); border-radius: 50%; opacity: 0.2; }

.glow-one { width: 380px; height: 380px; background: rgb(40, 88, 169); top: 100px; right: -120px; }

.glow-two { width: 300px; height: 300px; background: rgb(98, 54, 160); top: 900px; left: -180px; }

.site-header { position: sticky; top: 0px; z-index: 20; background: rgba(8, 11, 20, 0.82); backdrop-filter: blur(18px); border-bottom: 1px solid var(--line); }

.nav { height: 76px; display: flex; align-items: center; justify-content: space-between; }

.brand { font-size: 25px; font-weight: 800; letter-spacing: -2px; }

.brand span { color: var(--blue); }

.nav-links { display: flex; align-items: center; gap: 34px; color: rgb(183, 192, 209); font-size: 13px; font-weight: 700; }

.nav-links a:hover { color: white; }

.nav-contact { border: 1px solid var(--line); padding: 10px 16px; border-radius: 7px; color: white !important; }

.nav-contact span { color: var(--blue); margin-left: 8px; }

.menu-toggle { display: none; background: none; border: 0px; }

.hero { min-height: 680px; display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 40px; padding-top: 60px; padding-bottom: 85px; }

.eyebrow, .project-number { font: 11px var(--mono); letter-spacing: 1.7px; color: var(--blue); }

.eyebrow { display: flex; align-items: center; gap: 10px; }

.status-dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; box-shadow: 0 0 14px var(--green); }

.hello { font-size: 20px; color: rgb(181, 191, 208); margin-top: 30px; }

.hero h1 { font-size: clamp(54px, 7vw, 88px); letter-spacing: -6px; line-height: 1.08; font-weight: 800; margin: 7px 0px 12px; }

.gradient-text { background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-clip: text; color: transparent; }

.hero h2 { font-size: clamp(17px, 2vw, 23px); font-weight: 600; color: rgb(226, 232, 243); }

.muted { color: rgb(88, 101, 123); margin: 0px 7px; }

.hero-description { max-width: 550px; color: var(--muted); font-size: 15px; line-height: 1.9; margin: 22px 0px 28px; }

.hero-actions { display: flex; gap: 13px; flex-wrap: wrap; }

.button { padding: 13px 19px; border-radius: 7px; font-size: 13px; font-weight: 800; transition: 0.25s; }

.button-primary { background: linear-gradient(100deg, rgb(103, 215, 255), rgb(167, 139, 250)); color: rgb(7, 16, 27); }

.button-primary span { margin-left: 14px; }

.button-primary:hover { transform: translateY(-3px); box-shadow: rgba(101, 213, 255, 0.19) 0px 10px 30px; }

.button-ghost { border: 1px solid var(--line); color: rgb(233, 237, 245); }

.button-ghost:hover { border-color: var(--blue); }

.hero-meta { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 38px; color: rgb(132, 145, 168); font: 11px var(--mono); }

.hero-visual { min-height: 480px; display: grid; place-items: center; position: relative; }

.profile-card { position: relative; z-index: 2; width: min(330px, 78%); padding: 17px; background: linear-gradient(145deg, rgb(26, 38, 59), rgb(13, 20, 33)); border: 1px solid rgba(98, 115, 139, 0.27); border-radius: 16px; box-shadow: rgba(0, 0, 0, 0.533) 0px 35px 90px; transform: rotate(3deg); }

.card-top, .profile-card-bottom { display: flex; justify-content: space-between; align-items: center; }

.card-top { font: 9px var(--mono); letter-spacing: 1.5px; color: rgb(135, 150, 173); }

.live-indicator { color: var(--green); }

.profile-image-wrap { height: 300px; margin: 15px 0px; overflow: hidden; border-radius: 9px; background: radial-gradient(circle at 50% 25%, rgb(49, 93, 133), rgb(23, 36, 59) 55%, rgb(17, 24, 39)); position: relative; }

.profile-image { width: 100%; height: 100%; object-fit: cover; object-position: center center; }

.profile-fallback { display: none; width: 100%; height: 100%; place-items: center; font-size: 78px; font-weight: 800; letter-spacing: -8px; color: rgb(217, 243, 255); }

.profile-fallback span { color: var(--blue); }

.profile-card-bottom strong { display: block; font-size: 14px; }

.profile-card-bottom small { display: block; color: rgb(140, 155, 177); font-size: 10px; margin-top: 3px; }

.card-arrow { font-size: 24px; color: var(--blue); }

.orbit { position: absolute; border: 1px solid rgba(114, 202, 255, 0.208); border-radius: 50%; transform: rotate(-24deg); }

.orbit-a { width: 440px; height: 270px; }

.orbit-b { width: 500px; height: 350px; transform: rotate(45deg); border-color: rgba(167, 139, 250, 0.19); }

.floating-chip { position: absolute; z-index: 3; background: rgb(20, 30, 46); border: 1px solid rgba(110, 137, 172, 0.27); padding: 11px 14px; border-radius: 8px; font: 10px var(--mono); box-shadow: rgba(0, 0, 0, 0.467) 0px 12px 35px; color: rgb(217, 231, 246); }

.floating-chip span { color: var(--blue); margin-right: 7px; font-size: 14px; }

.chip-code { top: 75px; left: -5px; }

.chip-data { bottom: 75px; right: -10px; }

.visual-cross { position: absolute; color: var(--purple); font-size: 25px; }

.cross-one { top: 70px; right: 35px; }

.cross-two { bottom: 55px; left: 15px; color: var(--blue); }

.ticker { overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgb(11, 17, 29); padding: 17px 0px; }

.ticker-track { display: flex; justify-content: space-around; align-items: center; gap: 38px; min-width: 850px; font: 12px var(--mono); letter-spacing: 3px; color: rgb(137, 152, 177); }

.ticker-track b { color: var(--blue); font-size: 15px; }

.section { padding-top: 110px; padding-bottom: 110px; }

.section-heading { margin-bottom: 48px; }

.section-heading h2 { font-size: clamp(34px, 5vw, 49px); letter-spacing: -2px; line-height: 1.2; margin-top: 14px; }

.section-subtitle { color: var(--muted); font-size: 14px; margin-top: 14px; }

.about-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 90px; align-items: center; }

.large-copy { font-size: 25px; line-height: 1.55; font-weight: 700; letter-spacing: -0.6px; }

.accent { color: var(--blue); }

.body-copy { color: var(--muted); font-size: 14px; line-height: 2; margin-top: 22px; max-width: 620px; }

.info-panel { border: 1px solid var(--line); border-radius: 12px; padding: 8px 23px; background: linear-gradient(140deg, rgb(17, 26, 41), rgb(11, 17, 28)); }

.info-row { display: flex; justify-content: space-between; gap: 15px; padding: 19px 0px; border-bottom: 1px solid var(--line); }

.info-row:last-child { border: 0px; }

.info-row span { font: 10px var(--mono); letter-spacing: 1px; color: rgb(131, 146, 170); }

.info-row strong { font-size: 12px; text-align: right; }

.section-alt { background: rgb(12, 17, 29); border-top: 1px solid rgba(255, 255, 255, 0.03); border-bottom: 1px solid rgba(255, 255, 255, 0.03); }

.skills-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }

.skill-card { padding: 23px 18px; background: linear-gradient(145deg, rgb(20, 30, 45), rgb(13, 20, 32)); border: 1px solid var(--line); border-radius: 10px; transition: 0.25s; }

.skill-card:hover, .journey-card:hover { transform: translateY(-5px); border-color: rgba(101, 213, 255, 0.396); }

.skill-icon { width: 43px; height: 43px; display: grid; place-items: center; border-radius: 9px; background: rgba(101, 213, 255, 0.08); color: var(--blue); font: 14px var(--mono); margin-bottom: 23px; }

.skill-card h3 { font-size: 15px; }

.skill-card p { font-size: 11px; color: var(--muted); margin-top: 5px; min-height: 35px; }

.skill-tag { display: inline-block; font: 9px var(--mono); color: rgb(154, 169, 192); border: 1px solid var(--line); padding: 5px 8px; border-radius: 4px; margin-top: 16px; }

.project-card { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 13px; overflow: hidden; background: linear-gradient(120deg, rgb(17, 26, 41), rgb(13, 20, 32)); }

.project-art { min-height: 380px; background: radial-gradient(circle at 50% 45%, rgb(30, 77, 104), rgb(16, 27, 44) 48%, rgb(12, 19, 32)); display: flex; flex-direction: column; justify-content: space-between; padding: 24px; position: relative; overflow: hidden; }

.project-art::before { content: ""; position: absolute; inset: 0px; background-image: linear-gradient(rgba(139, 220, 255, 0.043) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 220, 255, 0.043) 1px, transparent 1px); background-size: 30px 30px; }

.scan-frame { position: relative; margin: auto; width: 220px; height: 250px; display: grid; place-items: center; }

.scan-label { position: absolute; top: 0px; left: 0px; font: 8px var(--mono); color: var(--green); letter-spacing: 1px; }

.cosmetic-bottle { display: flex; align-items: center; flex-direction: column; filter: drop-shadow(rgba(0, 0, 0, 0.533) 0px 20px 25px); }

.bottle-cap { width: 47px; height: 25px; background: linear-gradient(90deg, rgb(130, 148, 167), rgb(215, 228, 237), rgb(100, 120, 140)); border-radius: 5px 5px 2px 2px; }

.bottle-neck { width: 35px; height: 18px; background: rgb(156, 184, 199); }

.bottle-body { height: 145px; width: 105px; border-radius: 15px 15px 23px 23px; background: linear-gradient(100deg, rgb(155, 197, 199), rgb(224, 238, 229) 45%, rgb(113, 155, 165)); display: grid; place-items: center; position: relative; color: rgb(22, 49, 61); text-align: center; font: 10px var(--mono); letter-spacing: 2px; }

.bottle-body b { font-size: 19px; letter-spacing: 4px; }

.bottle-body i { position: absolute; width: 75px; height: 1px; background: rgb(70, 109, 117); bottom: 25px; }

.scan-line { position: absolute; left: 20px; right: 20px; top: 53%; height: 1px; background: rgb(141, 245, 217); box-shadow: rgb(141, 245, 217) 0px 0px 12px; animation: 3s ease-in-out 0s infinite alternate none running scan; }

.scan-corner { position: absolute; width: 22px; height: 22px; border-color: var(--green); }

.corner-a { top: 25px; left: 15px; border-top: 1px solid; border-left: 1px solid; }

.corner-b { top: 25px; right: 15px; border-top: 1px solid; border-right: 1px solid; }

.corner-c { bottom: 10px; left: 15px; border-bottom: 1px solid; border-left: 1px solid; }

.corner-d { bottom: 10px; right: 15px; border-bottom: 1px solid; border-right: 1px solid; }

.art-caption { position: relative; display: flex; justify-content: space-between; font: 9px var(--mono); letter-spacing: 1px; color: rgb(155, 177, 198); }

.art-caption span { color: var(--green); }

.project-info { padding: 50px 42px; align-self: center; }

.project-info h3 { font-size: 29px; line-height: 1.3; letter-spacing: -1px; margin: 17px 0px; }

.project-info > p:not(.project-number) { font-size: 13px; color: var(--muted); line-height: 1.9; }

.project-tags { display: flex; gap: 8px; flex-wrap: wrap; margin: 25px 0px; }

.project-tags span { font: 9px var(--mono); padding: 7px 9px; border: 1px solid var(--line); border-radius: 4px; color: rgb(170, 183, 201); }

.project-links a { font-size: 12px; font-weight: 800; color: var(--blue); border-bottom: 1px solid rgba(101, 213, 255, 0.4); padding-bottom: 5px; }

.journey-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; }

.journey-card { background: linear-gradient(145deg, rgb(20, 30, 45), rgb(13, 20, 32)); border: 1px solid var(--line); border-radius: 10px; padding: 28px; transition: 0.25s; }

.journey-symbol { font-size: 25px; color: var(--blue); display: block; margin-bottom: 22px; }

.journey-card h3 { font-size: 19px; margin: 12px 0px; }

.journey-card > p:last-child { font-size: 12px; line-height: 1.9; color: var(--muted); }

.contact-section { padding-top: 90px; padding-bottom: 90px; }

.contact-box { padding: 55px; display: grid; grid-template-columns: 1fr 0.9fr; gap: 55px; border: 1px solid rgba(117, 207, 255, 0.208); border-radius: 14px; background: radial-gradient(at 15% 10%, rgb(27, 58, 86) 0%, rgb(17, 26, 42) 42%, rgb(13, 20, 32) 80%); }

.contact-box h2 { font-size: clamp(38px, 5vw, 54px); line-height: 1.2; letter-spacing: -2px; margin: 18px 0px; }

.contact-copy { font-size: 13px; color: var(--muted); max-width: 380px; line-height: 1.9; }

.contact-details { display: flex; flex-direction: column; justify-content: center; }

.contact-details a { padding: 13px 0px; border-bottom: 1px solid var(--line); font-size: 12px; overflow-wrap: anywhere; }

.contact-details a span { display: block; color: var(--blue); font: 9px var(--mono); letter-spacing: 1.5px; margin-bottom: 5px; }

.contact-details a:hover { color: var(--blue); }

.footer { min-height: 90px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); gap: 15px; }

.footer p { font-size: 10px; color: rgb(127, 139, 160); }

.back-top { font: 9px var(--mono); letter-spacing: 1px; color: rgb(168, 182, 202); }

@keyframes scan { 
  0% { transform: translateY(-48px); opacity: 0.3; }
  100% { transform: translateY(48px); opacity: 1; }
}

@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr 0.8fr; gap: 10px; }
  .hero h1 { font-size: 64px; }
  .skills-grid { grid-template-columns: repeat(3, 1fr); }
  .about-grid { gap: 35px; }
  .project-info { padding: 35px 28px; }
  .contact-box { padding: 40px; gap: 30px; }
}

@media (max-width: 680px) {
  .container { width: min(100% - 36px, 540px); }
  .nav { height: 66px; }
  .menu-toggle { display: flex; flex-direction: column; gap: 6px; padding: 8px; }
  .menu-toggle span { display: block; width: 23px; height: 2px; background: white; }
  .nav-links { display: none; position: absolute; top: 66px; left: 0px; right: 0px; padding: 22px 25px 25px; background: rgb(13, 20, 32); border-bottom: 1px solid var(--line); flex-direction: column; align-items: stretch; gap: 18px; }
  .nav-links.open { display: flex; }
  .nav-contact { text-align: center; }
  .hero { display: flex; flex-direction: column; align-items: flex-start; padding-top: 65px; padding-bottom: 65px; gap: 25px; }
  .hero h1 { font-size: clamp(52px, 13vw, 70px); letter-spacing: -4px; }
  .hero-visual { width: 100%; min-height: 420px; align-self: center; }
  .profile-card { width: 260px; }
  .profile-image-wrap { height: 245px; }
  .orbit-a { width: 330px; height: 220px; }
  .orbit-b { width: 350px; height: 280px; }
  .chip-code { left: 0px; top: 55px; }
  .chip-data { right: 0px; bottom: 50px; }
  .hero-meta { gap: 12px; flex-direction: column; }
  .ticker-track { justify-content: flex-start; padding-left: 20px; }
  .section { padding-top: 78px; padding-bottom: 78px; }
  .section-heading { margin-bottom: 32px; }
  .about-grid, .project-card, .contact-box { grid-template-columns: 1fr; }
  .about-grid { gap: 30px; }
  .large-copy { font-size: 21px; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .skill-card { padding: 18px 14px; }
  .project-art { min-height: 330px; }
  .project-info { padding: 30px 24px; }
