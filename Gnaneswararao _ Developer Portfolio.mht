  .journey-grid { grid-template-columns: 1fr; }
  .contact-section { padding-top: 65px; padding-bottom: 65px; }
  .contact-box { padding: 30px 23px; gap: 25px; }
  .contact-box h2 { font-size: 43px; }
  .footer { padding: 22px 0px; flex-wrap: wrap; }
  .footer p { order: 3; width: 100%; }
}

